{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "KafkaSettings": {
    "BootstrapServers": "localhost:9092",
    "GroupId": "fcs-donation-worker-consumer-group",
    "ConsumerTimeoutMs": 100,
    "Topics": {
      "DonationReceived": "donation-received",
      "AuditLogRequested": "audit-log-requested"
    }
  },
  "ConnectionStrings": {
    "SqlServer": "Server=localhost,1433;Database=DonationsDb;User Id=sa;Password=Your_password123;TrustServerCertificate=True"
  },
  "CampaignsApi": {
    "BaseUrl": "http://localhost:5002",
    "Retry": {
      "RetryCount": 3,
      "BaseDelayMilliseconds": 200
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Seq" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      }
    ]
  }
}
